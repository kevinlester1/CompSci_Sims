rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /tasks/{taskId} {
      allow read, create, update, delete: if true;
    }

    match /userProfiles/{userId}/{document=**} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /userScores/{userId}/{document=**} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /leaderboard/{userId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/{document=**} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /artifacts/{appId}/users/{userId}/{document=**} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /artifacts/{appId}/public/data/leaderboard/{userId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, create, update, delete: if isSignedIn();
    }
  }
}
